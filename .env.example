# Copy to .env.local and fill in real values. Never commit .env.local.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<name>

# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_SECRET=generate-a-32-byte-hex-key
APP_BASE_URL=https://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_BASE_URL=https://localhost:3000
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_APP_URL=https://localhost:3000
AUTH0_MOBILE_AUDIENCE=

# Google (optional; used by sync-google-fix.js and admin integrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:3000/api/admin/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_SYNC_EMAIL=
